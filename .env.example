# HackerOne Hacker API — hackerone.com/settings/api_token 에서 발급 (무료, 크레딧 불필요)
H1_USERNAME=your-h1-username
H1_API_TOKEN=your-h1-api-token

# Mattermost — 같은 docker 네트워크 안이면 컨테이너/서비스명을 host로 사용
MM_URL=mattermost
MM_PORT=8065
MM_SCHEME=http
MM_BOT_TOKEN=your-bot-personal-access-token
MM_CHANNEL_ID=결과를_올릴_채널_id
MM_SLASH_TOKEN=슬래시_커맨드_설정에서_받은_token   # 비워두면 검증 생략(권장하지 않음)

# AI (OpenAI 호환 아무 엔드포인트나)
AI_BASE_URL=                      # 비워두면 OpenAI 공식 엔드포인트 사용
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini

DB_PATH=/data/hunt.db
TOP_N_CANDIDATES=5
